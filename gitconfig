# https://github.com/drduh/config/blob/main/gitconfig
[user]
	name       = drduh
	email      = github@duh.to
	signingkey = "0xFF3E7D88647EBCDB"
[core]
	bare       = false
	filemode   = true
	pager      = less -XRF
	logallrefupdates = true
	repositoryformatversion = 0
#[remote "origin"]
#	url        = https://github.com/drduh/config
#	pushurl    = git@github.com:drduh/config.git
#	fetch      = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote     = origin
	merge      = refs/heads/main
[alias]
	authors    = !git log --format='%aN <%aE>' | sort -u
	dif        = diff
	diffmain   = diff main..HEAD
	diffmstr   = diff master..HEAD
	ignored    = ls-files --others --ignored --exclude-standard
	last       = !stat -f \"%Sm\" $(git rev-parse --show-toplevel)/.git/FETCH_HEAD
	lg         = log --graph --decorate --oneline
	ll         = log --stat
	og         = log
	pending    = diff --cached origin/main
	resetmain  = !git fetch origin && git reset --hard origin/main
