# https://github.com/drduh/config/blob/main/zsh/zshPath

function path {
  if [[ -d "${1}" ]] ; then
    if [[ -z "${PATH}" ]] ; then
      export PATH="${1}"
    else
      export PATH="${PATH}:${1}"
    fi
  else
    printf 'invalid path: '%s'\n' "${1}"
  fi
}

export PATH=""
path "/sbin"
path "/bin"
path "/usr/sbin"
path "/usr/bin"
path "/usr/local/sbin"
path "/usr/local/bin"
path "/usr/local/go/bin"
